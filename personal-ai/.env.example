# Neon Postgres connection string
DATABASE_URL=

# Anthropic API key — the model powering the chat/analysis/predictions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Passcode to log into the app, and secret used to sign session cookies
APP_PASSCODE=
SESSION_SECRET=

# Resend (email) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_EMAIL_TO=

# Public URL of the deployed app, used in email links
APP_URL=

# Set automatically as a Vercel env var; Vercel signs Cron requests with it
CRON_SECRET=
